# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# raw camera footage (keep repo lean — web uses compressed mp4s)
public/assets/gallary/*.MOV
public/assets/gallary/*.mov
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite db (Phase 7 MVP datastore — never commit seeded credentials/data)
prisma/*.db
prisma/*.db-journal

# local object storage (Phase 4/ADR-03 — raw uploaded evidence artifacts)
/storage


# local Qdrant binary + storage (downloaded, not committed)
/.qdrant

# Python RAG service venv
rag_service/.venv
rag_service/__pycache__
